# Zero Trust Dashboard Backend Configuration

# Application Settings
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# AWS Configuration
AWS_REGION=us-west-2
PROJECT_NAME=zero-trust-arch
ENVIRONMENT=dev

# Cognito Configuration (Get these from Terraform outputs)
COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Security Settings
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
ALLOWED_IP_RANGES=10.0.0.0/16,192.168.1.0/24

# Database Configuration (Optional - for RDS connection)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zerotrust
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=true

# Monitoring and Alerting
CLOUDWATCH_LOG_GROUP=/aws/application/zero-trust-dashboard
SNS_TOPIC_ARN=arn:aws:sns:us-west-2:123456789012:zero-trust-alerts

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-in-production
JWT_SECRET=your-jwt-secret-key-change-in-production

# Feature Flags
ENABLE_SWAGGER_DOCS=true
ENABLE_METRICS_ENDPOINT=true
ENABLE_DEBUG_LOGGING=false

# Third-party Services
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
EMAIL_SERVICE_API_KEY=your-email-service-api-key